# API base URL. In dev, Vite proxies /api to VITE_API_PROXY_TARGET, so keep this relative.
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=https://apierp.holydeen.com
VITE_APP_NAME=Holydeen ERP
VITE_DEFAULT_CURRENCY=BDT
VITE_DEFAULT_LOCALE=en

# Origin that serves /uploads (avatars). Empty = same origin (dev proxy).
VITE_ASSET_URL=

# Production build (`npm run build`) reads .env.production, which must use absolute URLs because the
# deployed static site has no proxy:
#   VITE_API_URL=https://apierp.holydeen.com/api/v1
#   VITE_ASSET_URL=https://apierp.holydeen.com
