# Everything Vite writes to dist/assets has a content hash in its file name, so a changed file
# always gets a new name. Let browsers keep these for a year instead of re-downloading them on
# every page load (less traffic and fewer requests on the hosting plan).
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
